<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A00E5FF" />
            <size android:width="84dp" android:height="84dp" />
        </shape>
    </item>

    <!-- Outer Circuit Ring -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/jarvis_cyan_primary" />
            <solid android:color="#3300E5FF" />
        </shape>
    </item>

    <!-- Inner Core Reactor -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/jarvis_card_bg" />
            <stroke android:width="1.5dp" android:color="@color/jarvis_cyan_primary" />
        </shape>
    </item>
</layer-list>
